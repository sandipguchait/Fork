{
	"name": "fork-ai",
	"displayName": "Companion",
	"description": "Chat, inline edits, an agent with MCP tools and a sandbox, and codebase search on your own models: any OpenAI-compatible, Anthropic or Gemini endpoint.",
	"version": "0.5.0",
	"publisher": "fork",
	"license": "MIT",
	"private": true,
	"engines": {
		"vscode": "^1.100.0"
	},
	"main": "./dist/extension",
	"activationEvents": [
		"onStartupFinished"
	],
	"categories": [
		"AI",
		"Chat"
	],
	"extensionKind": [
		"ui"
	],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"viewsContainers": {
			"secondarySidebar": [
				{
					"id": "forkAi",
					"title": "Companion",
					"icon": "media/fork-ai.svg"
				}
			]
		},
		"views": {
			"forkAi": [
				{
					"type": "webview",
					"id": "forkAi.chat",
					"name": "Companion"
				}
			]
		},
		"commands": [
			{
				"command": "forkAi.openChat",
				"title": "Open Chat",
				"category": "Companion"
			},
			{
				"command": "forkAi.newChat",
				"title": "New Chat",
				"category": "Companion",
				"icon": "$(add)"
			},
			{
				"command": "forkAi.chatHistory",
				"title": "Chat History",
				"category": "Companion",
				"icon": "$(history)"
			},
			{
				"command": "forkAi.addSelectionToChat",
				"title": "Add Selection to Chat",
				"category": "Companion"
			},
			{
				"command": "forkAi.addFileToChat",
				"title": "Add File to Chat",
				"category": "Companion"
			},
			{
				"command": "forkAi.addModel",
				"title": "Add Model",
				"category": "Companion"
			},
			{
				"command": "forkAi.manageModels",
				"title": "Manage Models",
				"category": "Companion",
				"icon": "$(gear)"
			},
			{
				"command": "forkAi.inlineEdit",
				"title": "Edit with Companion",
				"category": "Companion"
			},
			{
				"command": "forkAi.acceptAllEdits",
				"title": "Accept All Edits",
				"category": "Companion",
				"icon": "$(check-all)"
			},
			{
				"command": "forkAi.rejectAllEdits",
				"title": "Reject All Edits",
				"category": "Companion",
				"icon": "$(close-all)"
			},
			{
				"command": "forkAi.acceptEdit",
				"title": "Accept Edit",
				"category": "Companion"
			},
			{
				"command": "forkAi.rejectEdit",
				"title": "Reject Edit",
				"category": "Companion"
			},
			{
				"command": "forkAi.cancelEdit",
				"title": "Cancel Edit",
				"category": "Companion"
			},
			{
				"command": "forkAi.applyCode",
				"title": "Apply Code from Chat",
				"category": "Companion"
			},
			{
				"command": "forkAi.addCodebaseToChat",
				"title": "Add Codebase to Chat",
				"category": "Companion"
			},
			{
				"command": "forkAi.reindex",
				"title": "Reindex Codebase",
				"category": "Companion"
			},
			{
				"command": "forkAi.chooseEmbeddingModel",
				"title": "Choose Embedding Model for Codebase Search",
				"category": "Companion"
			},
			{
				"command": "forkAi.indexMenu",
				"title": "Codebase Index",
				"category": "Companion"
			},
			{
				"command": "forkAi.editForkignore",
				"title": "Edit .forkignore",
				"category": "Companion"
			},
			{
				"command": "forkAi.mcpServers",
				"title": "MCP Servers",
				"category": "Companion",
				"icon": "$(plug)"
			},
			{
				"command": "forkAi.editUserMcp",
				"title": "Edit User MCP Servers (~/.fork/mcp.json)",
				"category": "Companion"
			},
			{
				"command": "forkAi.editProjectMcp",
				"title": "Edit Project MCP Servers (.fork/mcp.json)",
				"category": "Companion"
			},
			{
				"command": "forkAi.reloadMcp",
				"title": "Reload MCP Servers",
				"category": "Companion"
			},
			{
				"command": "forkAi.pickChatModel",
				"title": "Switch Model",
				"category": "Companion"
			},
			{
				"command": "forkAi.shareChat",
				"title": "Copy Chat as Markdown",
				"category": "Companion"
			},
			{
				"command": "forkAi.askCompanion",
				"title": "Ask Companion",
				"category": "Companion"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "forkAi.newChat",
					"when": "view == forkAi.chat",
					"group": "navigation@1"
				},
				{
					"command": "forkAi.chatHistory",
					"when": "view == forkAi.chat",
					"group": "navigation@2"
				},
				{
					"command": "forkAi.manageModels",
					"when": "view == forkAi.chat",
					"group": "navigation@3"
				},
				{
					"command": "forkAi.mcpServers",
					"when": "view == forkAi.chat",
					"group": "navigation@4"
				}
			],
			"editor/context": [
				{
					"command": "forkAi.inlineEdit",
					"when": "!editorReadonly",
					"group": "1_forkAi@1"
				},
				{
					"command": "forkAi.addSelectionToChat",
					"when": "editorHasSelection",
					"group": "1_forkAi@2"
				}
			],
			"explorer/context": [
				{
					"command": "forkAi.addFileToChat",
					"when": "!explorerResourceIsFolder",
					"group": "1_forkAi"
				}
			],
			"commandPalette": [
				{
					"command": "forkAi.acceptEdit",
					"when": "false"
				},
				{
					"command": "forkAi.rejectEdit",
					"when": "false"
				},
				{
					"command": "forkAi.applyCode",
					"when": "false"
				},
				{
					"command": "forkAi.acceptAllEdits",
					"when": "forkAi.reviewing"
				},
				{
					"command": "forkAi.rejectAllEdits",
					"when": "forkAi.reviewing"
				},
				{
					"command": "forkAi.cancelEdit",
					"when": "forkAi.generating"
				},
				{
					"command": "forkAi.inlineEdit",
					"when": "editorIsOpen && !editorReadonly"
				}
			],
			"editor/title": [
				{
					"command": "forkAi.acceptAllEdits",
					"when": "forkAi.reviewing",
					"group": "navigation@1"
				},
				{
					"command": "forkAi.rejectAllEdits",
					"when": "forkAi.reviewing",
					"group": "navigation@2"
				}
			]
		},
		"keybindings": [
			{
				"command": "forkAi.addSelectionToChat",
				"key": "ctrl+l",
				"mac": "cmd+l",
				"when": "editorTextFocus && editorHasSelection"
			},
			{
				"command": "forkAi.openChat",
				"key": "ctrl+l",
				"mac": "cmd+l",
				"when": "!editorTextFocus || !editorHasSelection"
			},
			{
				"command": "forkAi.inlineEdit",
				"key": "ctrl+i",
				"mac": "cmd+i",
				"when": "editorTextFocus && !editorReadonly"
			},
			{
				"command": "forkAi.acceptAllEdits",
				"key": "ctrl+enter",
				"mac": "cmd+enter",
				"when": "editorTextFocus && forkAi.reviewing"
			},
			{
				"command": "forkAi.rejectAllEdits",
				"key": "ctrl+backspace",
				"mac": "cmd+backspace",
				"when": "editorTextFocus && forkAi.reviewing"
			},
			{
				"command": "forkAi.cancelEdit",
				"key": "escape",
				"when": "editorTextFocus && forkAi.generating"
			}
		],
		"configuration": {
			"title": "Companion",
			"properties": {
				"forkAi.chat.includeCurrentFile": {
					"type": "boolean",
					"default": true,
					"description": "Send the open file with each chat message. You can still remove it per message from the chat box."
				},
				"forkAi.index.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Index the open folder for codebase search: the agent's codebase_search tool and Codebase context in chat. The index stays on this computer; only with an embedding model set is code sent, to that model's endpoint."
				},
				"forkAi.index.maxFiles": {
					"type": "number",
					"default": 15000,
					"minimum": 100,
					"description": "Most files to index. Source files are indexed before tests and fixtures."
				},
				"forkAi.index.maxFileSizeKB": {
					"type": "number",
					"default": 512,
					"minimum": 1,
					"description": "Files larger than this are left out of the index."
				},
				"forkAi.index.maxTotalSizeMB": {
					"type": "number",
					"default": 100,
					"minimum": 1,
					"description": "Indexing stops once this much text is indexed. The index uses about 2-3 times this in memory."
				},
				"forkAi.index.exclude": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "More files to leave out of the index, in .gitignore syntax, e.g. \"fixtures/\" or \"*.generated.ts\". .gitignore and .forkignore are followed too."
				},
				"forkAi.mcp.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Start the MCP servers in ~/.fork/mcp.json and the project's .fork/mcp.json, and give their tools to the agent. Project servers start only after you trust them."
				},
				"forkAi.agent.sandbox": {
					"type": "string",
					"enum": [
						"auto",
						"off"
					],
					"enumDescriptions": [
						"Run the agent's commands in a sandbox where this computer has one (macOS; Linux with bubblewrap): they can write only inside the project, the temp folder and the folders in Sandbox Allow Write.",
						"Run commands without a sandbox. They still ask for approval as usual."
					],
					"default": "auto",
					"description": "Whether the agent's commands run in an OS sandbox."
				},
				"forkAi.agent.sandboxAllowWrite": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"~/.npm",
						"~/.cache",
						"~/.pnpm-store",
						"~/Library/Caches",
						"~/Library/pnpm",
						"~/.yarn/berry/cache",
						"~/.bun/install/cache",
						"~/.cargo/registry",
						"~/.cargo/git",
						"~/go/pkg/mod",
						"~/.gradle/caches",
						"~/.m2/repository"
					],
					"description": "Folders outside the project that sandboxed commands may write to: package caches, so installs and builds work. \"~/\" is the home folder."
				},
				"forkAi.agent.sandboxNetwork": {
					"type": "boolean",
					"default": true,
					"description": "Let sandboxed commands use the network. Turn off to keep tests and scripts from reaching the internet (package installs will fail)."
				}
			}
		}
	},
	"scripts": {
		"compile": "node ./esbuild.mts && node ./esbuild.webview.mts",
		"watch": "node ./esbuild.mts --watch",
		"test": "node --test test/*.test.ts"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/sandipguchait/Fork.git"
	}
}
