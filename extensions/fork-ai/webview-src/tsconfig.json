{
	"compilerOptions": {
		"target": "ES2024",
		"lib": [
			"ES2024",
			"DOM",
			"DOM.Iterable"
		],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"types": []
	},
	"include": [
		"./**/*"
	]
}
