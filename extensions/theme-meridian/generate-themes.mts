}

function tokenColors(s) {
	const rule = (scope, foreground, fontStyle) => ({ scope, settings: { foreground, ...(fontStyle ? { fontStyle } : {}) } });
	return [
		rule(['comment', 'punctuation.definition.comment', 'string.comment'], s.comment, 'italic'),
		rule(['keyword', 'storage', 'storage.type', 'storage.modifier', 'keyword.control', 'keyword.operator.new', 'keyword.operator.expression', 'keyword.operator.logical.python', 'variable.language.this', 'variable.language.self', 'variable.language.super'], s.keyword),
		rule(['keyword.operator', 'punctuation.separator.key-value', 'punctuation.accessor', 'keyword.operator.type.annotation'], s.operator),
		rule(['string', 'string.quoted', 'string.template', 'punctuation.definition.string', 'markup.inline.raw'], s.string),
		rule(['string.regexp', 'constant.regexp'], s.regexp),
		rule(['constant.character.escape', 'constant.other.placeholder', 'punctuation.definition.template-expression', 'punctuation.section.embedded'], s.escape),
		rule(['constant.numeric', 'constant.language', 'constant.language.boolean', 'constant.language.null', 'variable.other.enummember', 'entity.name.constant', 'variable.other.constant', 'support.constant'], s.number),
		rule(['entity.name.function', 'support.function', 'meta.function-call entity.name.function', 'variable.function', 'entity.name.method'], s.function),
		rule(['entity.name.type', 'entity.name.class', 'entity.name.namespace', 'entity.other.inherited-class', 'support.type', 'support.class', 'storage.type.primitive', 'entity.name.type.interface', 'meta.type.annotation entity.name.type'], s.type),
		rule(['variable', 'variable.other', 'variable.other.readwrite', 'meta.definition.variable'], s.variable),
		rule(['variable.parameter', 'meta.parameters variable'], s.parameter, 'italic'),
		rule(['variable.other.property', 'variable.other.object.property', 'support.variable.property', 'meta.object-literal.key', 'support.type.property-name', 'support.type.property-name.json', 'entity.name.tag.yaml', 'string.unquoted.key'], s.property),
		rule(['punctuation', 'meta.brace', 'punctuation.definition.block', 'punctuation.separator', 'punctuation.terminator', 'meta.delimiter'], s.punctuation),
		rule(['entity.name.tag', 'punctuation.definition.tag', 'meta.tag'], s.tag),
		rule(['entity.other.attribute-name', 'entity.other.attribute-name.html', 'entity.other.attribute-name.class.css', 'entity.other.attribute-name.id.css'], s.attribute),
		rule(['support.type.property-name.css', 'support.type.vendored.property-name.css'], s.property),
		rule(['support.constant.property-value.css', 'constant.other.color.rgb-value', 'keyword.other.unit'], s.number),
		rule(['entity.name.section.markdown', 'markup.heading', 'markup.heading entity.name'], s.keyword, 'bold'),
		rule(['markup.bold'], s.variable, 'bold'),
		rule(['markup.italic'], s.variable, 'italic'),
		rule(['markup.underline.link', 'string.other.link'], s.function),
		rule(['markup.quote'], s.comment, 'italic'),
		rule(['markup.list punctuation.definition.list.begin'], s.keyword),
		rule(['markup.inserted', 'meta.diff.header.to-file', 'punctuation.definition.inserted'], s.string),
		rule(['markup.deleted', 'meta.diff.header.from-file', 'punctuation.definition.deleted'], s.invalid),
		rule(['markup.changed', 'punctuation.definition.changed'], s.number),
		rule(['meta.decorator', 'entity.name.function.decorator', 'punctuation.decorator'], s.type),
		rule(['invalid', 'invalid.illegal'], s.invalid),
		rule(['invalid.deprecated'], s.comment, 'strikethrough'),
	];
}

function semanticTokenColors(s) {
	return {
		'parameter': { foreground: s.parameter, italic: true },
		'property': s.property,
		'property.readonly': s.property,
		'enumMember': s.number,
		'variable.readonly': s.variable,
		'variable.defaultLibrary': s.type,
		'function': s.function,
		'method': s.function,
		'type': s.type,
		'class': s.type,
		'interface': s.type,
		'namespace': s.type,
		'typeParameter': s.type,
		'keyword': s.keyword,
		'decorator': s.type,
		'regexp': s.regexp,
	};
}

for (const [id, p] of Object.entries(PALETTES)) {
	const theme = {
		$schema: 'vscode://schemas/color-theme',
		name: p.name,
		type: p.type,
		semanticHighlighting: true,
		colors: workbenchColors(p),
		tokenColors: tokenColors(p.syntax),
		semanticTokenColors: semanticTokenColors(p.syntax),
	};
	writeFileSync(join(here, 'themes', `meridian-${id}.json`), JSON.stringify(theme, null, '\t') + '\n');
	console.log(`themes/meridian-${id}.json: ${Object.keys(theme.colors).length} colors`);
}
