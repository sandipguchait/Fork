			"scope": [
				"comment",
				"punctuation.definition.comment",
				"string.comment"
			],
			"settings": {
				"foreground": "#9A8D82",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword",
				"storage",
				"storage.type",
				"storage.modifier",
				"keyword.control",
				"keyword.operator.new",
				"keyword.operator.expression",
				"keyword.operator.logical.python",
				"variable.language.this",
				"variable.language.self",
				"variable.language.super"
			],
			"settings": {
				"foreground": "#FF9A6E"
			}
		},
		{
			"scope": [
				"keyword.operator",
				"punctuation.separator.key-value",
				"punctuation.accessor",
				"keyword.operator.type.annotation"
			],
			"settings": {
				"foreground": "#FFB892"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted",
				"string.template",
				"punctuation.definition.string",
				"markup.inline.raw"
			],
			"settings": {
				"foreground": "#B9DB9E"
			}
		},
		{
			"scope": [
				"string.regexp",
				"constant.regexp"
			],
			"settings": {
				"foreground": "#FFA5A5"
			}
		},
		{
			"scope": [
				"constant.character.escape",
				"constant.other.placeholder",
				"punctuation.definition.template-expression",
				"punctuation.section.embedded"
			],
			"settings": {
				"foreground": "#F4C86A"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.language.boolean",
				"constant.language.null",
				"variable.other.enummember",
				"entity.name.constant",
				"variable.other.constant",
				"support.constant"
			],
			"settings": {
				"foreground": "#F4C86A"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call entity.name.function",
				"variable.function",
				"entity.name.method"
			],
			"settings": {
				"foreground": "#FFD28A"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"entity.name.namespace",
				"entity.other.inherited-class",
				"support.type",
				"support.class",
				"storage.type.primitive",
				"entity.name.type.interface",
				"meta.type.annotation entity.name.type"
			],
			"settings": {
				"foreground": "#E9C9A8"
			}
		},
		{
			"scope": [
				"variable",
				"variable.other",
				"variable.other.readwrite",
				"meta.definition.variable"
			],
			"settings": {
				"foreground": "#F3EAE2"
			}
		},
		{
			"scope": [
				"variable.parameter",
				"meta.parameters variable"
			],
			"settings": {
				"foreground": "#E6D9CD",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"variable.other.object.property",
				"support.variable.property",
				"meta.object-literal.key",
				"support.type.property-name",
				"support.type.property-name.json",
				"entity.name.tag.yaml",
				"string.unquoted.key"
			],
			"settings": {
				"foreground": "#FFB892"
			}
		},
		{
			"scope": [
				"punctuation",
				"meta.brace",
				"punctuation.definition.block",
				"punctuation.separator",
				"punctuation.terminator",
				"meta.delimiter"
			],
			"settings": {
				"foreground": "#A59A8F"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"punctuation.definition.tag",
				"meta.tag"
			],
			"settings": {
				"foreground": "#FF9A6E"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name",
				"entity.other.attribute-name.html",
				"entity.other.attribute-name.class.css",
				"entity.other.attribute-name.id.css"
			],
			"settings": {
				"foreground": "#FFB892"
			}
		},
		{
			"scope": [
				"support.type.property-name.css",
				"support.type.vendored.property-name.css"
			],
			"settings": {
				"foreground": "#FFB892"
			}
		},
		{
			"scope": [
				"support.constant.property-value.css",
				"constant.other.color.rgb-value",
				"keyword.other.unit"
			],
			"settings": {
				"foreground": "#F4C86A"
			}
		},
		{
			"scope": [
				"entity.name.section.markdown",
				"markup.heading",
				"markup.heading entity.name"
			],
			"settings": {
				"foreground": "#FF9A6E",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.bold"
			],
			"settings": {
				"foreground": "#F3EAE2",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.italic"
			],
			"settings": {
				"foreground": "#F3EAE2",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.underline.link",
				"string.other.link"
			],
			"settings": {
				"foreground": "#FFD28A"
			}
		},
		{
			"scope": [
				"markup.quote"
			],
			"settings": {
				"foreground": "#9A8D82",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.list punctuation.definition.list.begin"
			],
			"settings": {
				"foreground": "#FF9A6E"
			}
		},
		{
			"scope": [
				"markup.inserted",
				"meta.diff.header.to-file",
				"punctuation.definition.inserted"
			],
			"settings": {
				"foreground": "#B9DB9E"
			}
		},
		{
			"scope": [
				"markup.deleted",
				"meta.diff.header.from-file",
				"punctuation.definition.deleted"
			],
			"settings": {
				"foreground": "#FF8E8E"
			}
		},
		{
			"scope": [
				"markup.changed",
				"punctuation.definition.changed"
			],
			"settings": {
				"foreground": "#F4C86A"
			}
		},
		{
			"scope": [
				"meta.decorator",
				"entity.name.function.decorator",
				"punctuation.decorator"
			],
			"settings": {
				"foreground": "#E9C9A8"
			}
		},
		{
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#FF8E8E"
			}
		},
		{
			"scope": [
				"invalid.deprecated"
			],
			"settings": {
				"foreground": "#9A8D82",
				"fontStyle": "strikethrough"
			}
		}
	],
	"semanticTokenColors": {
		"parameter": {
			"foreground": "#E6D9CD",
			"italic": true
		},
		"property": "#FFB892",
		"property.readonly": "#FFB892",
		"enumMember": "#F4C86A",
		"variable.readonly": "#F3EAE2",
		"variable.defaultLibrary": "#E9C9A8",
		"function": "#FFD28A",
		"method": "#FFD28A",
		"type": "#E9C9A8",
		"class": "#E9C9A8",
		"interface": "#E9C9A8",
		"namespace": "#E9C9A8",
		"typeParameter": "#E9C9A8",
		"keyword": "#FF9A6E",
		"decorator": "#E9C9A8",
		"regexp": "#FFA5A5"
	}
}
